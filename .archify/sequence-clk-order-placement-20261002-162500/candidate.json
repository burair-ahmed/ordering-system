  "cards": [
    {
      "dot": "emerald",
      "title": "Awaited vs Fire-and-Forget Semantics",
      "items": [
        "Live Queue Save (`Order.save`): AWAITED. Database failure returns 500 and halts checkout.",
        "Immutable Ledger Dual-Sync: AWAITED in try/catch. Non-blocking error logging guarantees zero disruption to diner.",
        "Meta Conversions API (CAPI): ASYNC / FIRE-AND-FORGET. Dispatches in background without delaying HTTP 201 response.",
        "Socket.IO Emit: Synchronous in-memory broadcast to connected kitchen/admin dashboards."
      ]
    },
    {
      "dot": "rose",
      "title": "Client-Side Side-Effect Isolation",
      "items": [
        "Twilio WhatsApp notification is executed client-side via `sendWhatsAppNotification` (`/api/send-whatsapp`).",
        "If Twilio fails (e.g. rate limit, unverified sandbox number), the error is caught and logged without aborting order success.",
        "Latest order number and phone are saved to `localStorage` before redirection to guarantee resilient `/thank-you` page hydration."
      ]
    },
    {
      "dot": "cyan",
      "title": "Error Visibility Matrix",
      "items": [
        "Closed Restaurant: 400 Bad Request with operating hours warning (6:30 PM–3:00 AM).",
        "Missing Fields: 400 Bad Request listing specific missing inputs (Name, Phone, Table/Area).",
        "Database Outage: 500 Server Error prompting customer to retry."
      ]
    }
  ]
