  "cards": [
    {
      "dot": "rose",
      "title": "PII Data Boundaries",
      "items": [
        "Internal Persistence: Customer name, phone, email, and street address are stored in MongoDB orders & OrderLedger.",
        "Third-Party Egress: Only Twilio receives raw phone numbers for transactional WhatsApp messages.",
        "Meta Conversions API (CAPI) receives strictly SHA-256 hashed phone and email values with deduplicated event IDs.",
        "GA4 & Microsoft Clarity receive anonymized session telemetry with masked form inputs."
      ]
    },
    {
      "dot": "cyan",
      "title": "Marketing Attribution Pipeline",
      "items": [
        "orderSource captures UTM source, medium, campaign, content, term, referrer, and landing page on arrival.",
        "Persisted across CartContext and OrderContext via localStorage and cookies.",
        "Preserved in OrderLedger to enable long-term CAC and ROAS channel performance analysis."
      ]
    },
    {
      "dot": "emerald",
      "title": "Consent & Feedback Handling",
      "items": [
        "NotificationConsent tracks customer opt-in for future promotional messaging.",
        "Feedback collection stores post-meal ratings and reviews linked by orderNumber.",
        "AnalyticsEvent logs conversion milestones without capturing unhashed personal data."
      ]
    }
  ]
